<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8">

    <ScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_default_greeting"
                android:textColor="#153D2E"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!--
            Dashboard summary displays the user's current weight,
            goal weight, and calculated progress using data retrieved
            from the SQLite database.
            -->

            <TextView
                android:id="@+id/textTodayProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/today_progress"
                android:textAlignment="center"
                android:textColor="#52645D"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCurrentWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/default_weight"
                android:textAlignment="center"
                android:textColor="#153D2E"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressGoal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="20dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#DDEBE4"
                android:progressTint="#247A52" />

            <TextView
                android:id="@+id/textProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="@string/default_progress"
                android:textColor="#153D2E"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textGoalWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/default_goal_weight"
                android:textColor="#52645D"
                android:textSize="15sp" />

            <Button
                android:id="@+id/buttonAddWeight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#247A52"
                android:text="@string/add_weight_button"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRecentEntriesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:text="@string/recent_entries"
                android:textAlignment="center"
                android:textColor="#153D2E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Displays the three most recent weight records from SQLite. -->
            <LinearLayout
                android:id="@+id/recentEntriesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E6F1EB"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/date_header"
                        android:textColor="#153D2E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/weight_header"
                        android:textColor="#153D2E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#B8CCC1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textRecentDateOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/no_entry"
                        android:textColor="#1F2925"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textRecentWeightOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/no_entry"
                        android:textColor="#1F2925"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textRecentDateTwo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/no_entry"
                        android:textColor="#1F2925"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textRecentWeightTwo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/no_entry"
                        android:textColor="#1F2925"
                        android:textSize="16sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textRecentDateThree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/no_entry"
                        android:textColor="#1F2925"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textRecentWeightThree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/no_entry"
                        android:textColor="#1F2925"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/textMotivation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/motivation_message"
                android:textColor="#5C6E65"
                android:textSize="15sp"
                android:textStyle="italic" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation shared across the main WeighPoint screens. -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="#EEF4F0"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_home"
            app:tint="#153D2E" />

        <ImageButton
            android:id="@+id/buttonHistory"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_history"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_history"
            app:tint="#60736A" />

        <ImageButton
            android:id="@+id/buttonGoals"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_goals"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_goal"
            app:tint="#60736A" />

        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_settings"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_settings"
            app:tint="#60736A" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>