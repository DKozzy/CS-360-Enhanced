<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8">

    <ScrollView
        android:id="@+id/weightHistoryScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navigationBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/textHistoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/weight_history_title"
                android:textAlignment="center"
                android:textColor="#153D2E"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHistorySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/weight_history_subtitle"
                android:textAlignment="center"
                android:textColor="#52645D"
                android:textSize="16sp" />

            <Button
                android:id="@+id/buttonAddWeight"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:backgroundTint="#247A52"
                android:text="@string/add_weight_button"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!--
Analytics controls allow the user to filter and sort
weight records and view calculated summary information.
-->
            <LinearLayout
                android:id="@+id/analyticsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_title"
                    android:textColor="#153D2E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/analytics_subtitle"
                    android:textColor="#52645D"
                    android:textSize="14sp" />

                <!-- Filtering and sorting controls. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinnerDateRange"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/editbox_background"
                        android:contentDescription="@string/analytics_date_range_description" />

                    <Spinner
                        android:id="@+id/spinnerSortOrder"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/editbox_background"
                        android:contentDescription="@string/analytics_sort_order_description" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#D7E3DD" />

                <!-- Calculated analytics summary. -->
                <TextView
                    android:id="@+id/textAnalyticsTrend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_trend_empty"
                    android:textColor="#1F2925"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textAnalyticsAverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/analytics_average_empty"
                    android:textColor="#52645D"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textAnalyticsMovingAverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/analytics_recent_average_empty"
                    android:textColor="#52645D"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textAnalyticsChange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/analytics_change_empty"
                    android:textColor="#52645D"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textAnalyticsRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/analytics_range_empty"
                    android:textColor="#52645D"
                    android:textSize="15sp" />

            </LinearLayout>

            <!--
            Weight history table containing dynamically generated
            SQLite records for the currently logged-in user.
            -->
            <LinearLayout
                android:id="@+id/historyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Table header. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="@string/date_header"
                        android:textColor="#153D2E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:text="@string/weight_header"
                        android:textColor="#153D2E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/delete_header"
                        android:textColor="#153D2E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D7E3DD" />

                <!--
                Weight history rows are populated dynamically from
                SQLite. Rows can be selected for editing and each
                delete button removes its corresponding record.
                -->
                <LinearLayout
                    android:id="@+id/historyRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom navigation shared across the main WeighPoint screens. -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="#EEF4F0"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/buttonHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_home"
            app:tint="#60736A" />

        <ImageButton
            android:id="@+id/buttonHistory"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_history"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_history"
            app:tint="#153D2E" />

        <ImageButton
            android:id="@+id/buttonGoals"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_goals"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_goal"
            app:tint="#60736A" />

        <ImageButton
            android:id="@+id/buttonSettings"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_settings"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_settings"
            app:tint="#60736A" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>